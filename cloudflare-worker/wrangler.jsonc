// Configuration de déploiement du relais de l'Assistant La Qualia.
// Sert quand le Worker « laqualia-agent » est relié à ce dépôt GitHub
// (Cloudflare > laqualia-agent > Paramètres > Builds > Connecter).
// Les variables et secrets (clé API, code d'équipe, SITE_URL, ALLOWED_ORIGINS)
// restent ceux définis dans le tableau de bord : keep_vars les protège.
{
  "name": "laqualia-agent",
  "main": "agent-worker.js",
  "compatibility_date": "2026-10-01",
  "keep_vars": true,
  "workers_dev": true,
  // Vérification automatique du site, de la clé API et du stockage toutes les 6 heures
  "triggers": { "crons": ["17 */6 * * *"] },
  // Alertes par courriel (Cloudflare Email Service) vers le propriétaire
  "send_email": [
    { "name": "ALERT_EMAIL" }
  ],
  // Stockage privé de la configuration et des bases de connaissances (Réception et TSA)
  "kv_namespaces": [
    { "binding": "AGENT_KV", "id": "47cb1b37991646f786a2ec7d00ed659e" }
  ],
  // Module Comptes : utilisateurs, établissements, membres, invitations (Cloudflare D1)
  "d1_databases": [
    { "binding": "DB", "database_name": "laqualia-comptes", "database_id": "58fc28a5-4443-4610-a161-e89882894ff1", "migrations_dir": "migrations" }
  ],
  // Connexion et API des comptes servies sur le site lui-même (témoins de session du même site)
  "routes": [
    { "pattern": "laqualia.com/auth/*", "zone_name": "laqualia.com" },
    { "pattern": "laqualia.com/api/*", "zone_name": "laqualia.com" }
  ]
}
